# 이 파일을 .env 로 복사하고 값을 채운다. .env 는 커밋하지 않는다.
#
# 토르소 DB — https://turso.tech 에서 DB를 만들고 아래 두 값을 받는다.
#   turso db show <이름> --url
#   turso db tokens create <이름>
TURSO_DATABASE_URL=libsql://<db이름>-<조직>.turso.io
TURSO_AUTH_TOKEN=<rw 토큰>

# 서버 포트 (render.com 은 PORT 를 직접 주입한다)
PORT=8787

# 클라이언트가 붙을 API 주소.
#   비워 두면  -> 브라우저 localStorage 에 저장 (서버 없이도 게임이 돈다)
#   채우면     -> 그 주소의 REST API = 토르소 DB
# 서버가 게임 정적 파일까지 같이 서빙하면(권장) 비워 둔 채로 배포해도 된다 —
# 그때는 URL 에 ?api=/api 를 붙이거나 VITE_API_BASE=/api 로 빌드한다.
VITE_API_BASE=
