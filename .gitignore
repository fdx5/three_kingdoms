node_modules/
dist/
*.local
.DS_Store
.vite/

# 접속 정보 — 절대 커밋하지 않는다
.env
.env.*
!.env.example

# 원본 아트(모델 하나가 60~90MB). 게임에 들어가는 것은 굽고 난 결과물
# public/assets/models/*.glb 이고, 그건 커밋한다. 원본은 저장소 밖에 둔다.
img/

# 개발 중 남는 것들
.vite-dev.*.log
artifacts/
scripts/_tmp-*.ts

# 설명서의 생성물. 파이프라인(manual/*.mjs)이 다시 만들 수 있고,
# 렌더 원본만 64MB라 저장소에 둘 것이 아니다.
manual/img/
manual/print/
manual/preview/
manual/manual.html
manual/*.pdf

# 로컬에서 서버를 띄울 때 남는 로그
.server.log
